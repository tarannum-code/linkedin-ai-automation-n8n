    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 201 -> published, 429 -> wait until midnight UTC (no retry), anything else -> pause everything + alert\nconst post = $('Gate & Pick').item.json;\nconst code = Number($json.statusCode);\nconst now = DateTime.now().toISO();\nif (code === 201) {\n  const urn = $json.headers?.['x-restli-id'] || $json.headers?.['x-linkedin-id'] || '';\n  return { json: { id: post.id, outcome: 'published', status: 'published', published_at: now, post_urn: urn,\n                   log_action: 'post_published', log_details: post.id + ' | ' + urn } };\n}\nif (code === 429) {\n  return { json: { id: post.id, outcome: 'rate_limited', log_action: 'rate_limited',\n                   log_details: post.id + ' | 429 from LinkedIn, no more calls until midnight UTC' } };\n}\nconst detail = JSON.stringify($json.body ?? $json).slice(0, 400);\nreturn { json: { id: post.id, outcome: 'error', log_action: 'paused_on_error',\n                 log_details: post.id + ' | HTTP ' + code + ' | ' + detail } };\n"
      },
