    {
      "parameters": {
        "jsCode": "// Publisher gate: pause, 429 wait, working hours, daily limit, 4 h gap -> picks ONE due approved post.\nconst ORG = 'urn:li:organization:YOUR_ORG_ID';\nconst s = $('Get Settings').first().json;\nconst posts = $('Get Posts').all().map(i => i.json).filter(p => p.id);\nconst logs = $('Get Logs').all().map(i => i.json);\nconst isTrue = v => String(v).trim().toUpperCase() === 'TRUE';\nlet manual = false;\ntry { manual = $('Manual run (test)').isExecuted; } catch (e) {}\n\nif (isTrue(s.paused)) return [];                                         // pause button\nconst todayUTC = DateTime.utc().toISODate();\nif (logs.some(l => l.action === 'rate_limited' && String(l.time).slice(0, 10) === todayUTC)) return []; // 429 -> wait until midnight UTC\n\nconst tz = s.timezone || 'Asia/Kolkata';\nconst now = DateTime.now().setZone(tz);\nconst [ws, we] = String(s.work_hours || '9-18').split(/[^0-9]+/).filter(Boolean).map(Number);\nif (!manual && (now.weekday > 5 || now.hour < ws || now.hour >= we)) return [];  // weekdays, working hours only\n\nconst published = posts.filter(p => p.status === 'published' && p.published_at)\n  .map(p => DateTime.fromISO(String(p.published_at)).setZone(tz));\nconst perDay = Number(s.posts_per_day) || 1;\nif (published.filter(d => d.toISODate() === now.toISODate()).length >= perDay) return [];   // daily limit\nconst gapH = Math.max(Number(s.post_gap_hours) || 4, 4);\nconst last = published.sort((a, b) => b - a)[0];\nif (last && now < last.plus({ hours: gapH })) return [];                 // min gap between posts\n\nconst due = posts.filter(p => p.status === 'approved' && p.scheduled_at &&\n                              DateTime.fromISO(String(p.scheduled_at)) <= now)\n                 .sort((a, b) => String(a.scheduled_at).localeCompare(String(b.scheduled_at)))[0];\nif (!due) return [];\n\n// LinkedIn \"little text\": escape reserved characters, keep hashtags clickable\nconst esc = t => String(t).replace(/[\\\\|{}@\\[\\]()<>#*_~]/g, m => '\\\\' + m);\nconst commentary = esc(due.text).replace(/\\\\#(\\w+)/g, '{hashtag|\\\\#|$1}');\n\nconst body = {\n  author: ORG,\n  commentary,\n  visibility: 'PUBLIC',\n  distribution: { feedDistribution: 'MAIN_FEED', targetEntities: [], thirdPartyDistributionChannels: [] },\n  lifecycleState: 'PUBLISHED',\n  isReshareDisabledByAuthor: false,\n};\nif (due.image_urn) body.content = { media: { id: String(due.image_urn) } };\n\nreturn [{ json: { id: due.id, body } }];\n"
      },
