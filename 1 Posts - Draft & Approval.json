    {
      "parameters": {
        "jsCode": "// Turns the AI Agent's JSON into one Posts row (+ image prompt).\nconst plans = $('Gate & Plan').all();\nreturn $input.all().map((it, i) => {\n  const raw = String(it.json.output ?? it.json.text ?? '');\n  let d;\n  try { d = JSON.parse(raw.replace(/^\\s*```(json)?/i, '').replace(/```\\s*$/, '').trim()); }\n  catch (e) { throw new Error('AI did not return valid JSON: ' + raw.slice(0, 300)); }\n  const tags = (d.hashtags || []).map(h => '#' + String(h).replace(/^#/, '').replace(/\\s+/g, '')).join(' ');\n  const raw2 = [d.hook, d.content, d.cta, tags].filter(Boolean).join('\\n\\n').trim();\n  const text = raw2.replace(/\\*\\*(.+?)\\*\\*/g, '$1').replace(/(^|\\s)\\*(\\S[^*\\n]*?)\\*(?=[\\s.,:;!?]|$)/g, '$1$2');   // LinkedIn has no markdown\n  const p = plans[i].json;\n  return { json: { id: p.id, text, status: 'pending', scheduled_at: p.scheduled_at,\n                   published_at: '', post_urn: '', image_urn: '', image_prompt: d.image_prompt || '' } };\n});\n"
      },
