        "jsCode": "const pick = (...names) => { for (const n of names) { try { return $(n); } catch (e) {} } throw new Error('Node not found: ' + names.join(' / ')); };\n// Picks ONE outreach action: follow-up due > first message (connected) > connection request (best fit)\nconst s = pick('Q: Get Settings').first().json;\nconst leads = pick('Q: Get Leads').all().map(i => i.json).filter(l => l.id);\nconst logs = pick('Q: Get Logs').all().map(i => i.json);\nconst norm = v => String(v || '').toLowerCase().trim();\nconst dnc = pick('Q: Get DoNotContact').all().map(i => norm(i.json.entry)).filter(Boolean);\nlet manual = false;\ntry { manual = $('Manual run (test)').isExecuted; } catch (e) {}\n\nif (String(s.paused).trim().toUpperCase() === 'TRUE') return [];\nconst tz = s.timezone || 'Asia/Kolkata';\nconst now = DateTime.now().setZone(tz);\nconst [ws, we] = String(s.work_hours || '9-18').split(/[^0-9]+/).filter(Boolean).map(Number);\nif (!manual && (now.weekday > 5 || now.hour < ws || now.hour >= we)) return [];      // weekdays, working hours\nif (leads.some(l => String(l.status).startsWith('awaiting'))) return [];               // one at a time, no bursts\n\nconst sentToday = logs.filter(l => l.action === 'outreach_sent' &&\n  DateTime.fromISO(String(l.time)).setZone(tz).toISODate() === now.toISODate())\n  .sort((a, b) => String(b.time).localeCompare(String(a.time)));\nif (sentToday.length >= (Number(s.outreach_per_day) || 3)) return [];                   // daily limit\nconst m = String(sentToday[0]?.details || '').match(/next_after=(\\S+)/);\nif (!manual && m && now < DateTime.fromISO(m[1])) return [];                            // random 20-40 min gap\n\nconst blocked = l => dnc.some(e => e === norm(l.name) || e === norm(l.company) || (l.profile_url && e === norm(l.profile_url)));\nconst due = d => d && DateTime.fromISO(String(d)) <= now;\nconst followups = leads.filter(l => l.status === 'messaged' && due(l.next_action_at));\nconst connected = leads.filter(l => l.status === 'connected');\nconst fresh = leads.filter(l => l.status === 'new').sort((a, b) => Number(b.fit_score) - Number(a.fit_score));\nconst pickOne = (arr, stage) => { const l = arr.find(x => !blocked(x)); return l ? { ...l, stage } : null; };\nconst lead = pickOne(followups, 'followup') || pickOne(connected, 'message') || pickOne(fresh, 'request');\nif (!lead) return [];\n\nconst who = `${lead.name}, ${lead.role} at ${lead.company}`;\nconst base = `We are YOUR_COMPANY_NAME. We sell a learning management system (LMS) that helps schools, colleges, training companies and HR/L&D teams run courses, track progress and certify learners.\nWrite to: ${who}.\nRules: honest, plain English, no false claims, no invented facts or numbers, no pressure, no links, do not pretend to know them, write as a real person from our team.`;\nconst task = {\n  request: `Write a LinkedIn connection request note. MAX 200 characters. Say who we are and why we want to connect (relevant to their role). No sales pitch.`,\n  message: `They accepted our connection request. Write the FIRST message (max 600 characters): who we are, why we are writing to them specifically, how our LMS could help someone in their role, one soft question. End with a clear way to say no, e.g. \"If this isn't relevant, just tell me and I won't message again.\"`,\n  followup: `We sent a first message ${s.followup_days || 5} days ago and got no answer. Write ONE short, polite follow-up (max 300 characters). No guilt, no pressure. Make it easy to say no. This is the last message we will send.`,\n}[lead.stage];\nreturn [{ json: { ...lead, prompt: base + '\\n\\n' + task + '\\n\\nAnswer with the message text only.' } }];\n"
      },
