      "parameters": {
        "jsCode": "const pick = (...names) => { for (const n of names) { try { return $(n); } catch (e) {} } throw new Error('Node not found: ' + names.join(' / ')); };\n// Pause check -> prompt for search planning\nconst s = pick('L: Get Settings').first().json;\nif (String(s.paused).trim().toUpperCase() === 'TRUE') return [];\nreturn [{ json: { audience: s.target_audience, prompt:\n`We sell a learning management system (LMS). Target audience: ${s.target_audience}\n\nWrite 4 different web search queries that find REAL, publicly named people who match this audience (e.g. a school's \"principal\" or \"director\" page, a training company's \"about us / team\" page, news or interviews with L&D or HR heads). Do not search LinkedIn.\nAnswer ONLY with JSON: {\"queries\":[\"\",\"\",\"\",\"\"]}` } }];\n"
      },
      "name": "L: Plan Searches",
      "type": "n8n-nodes-base.code",
