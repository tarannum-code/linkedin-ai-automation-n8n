    {
      "parameters": {
        "jsCode": "const pick = (...names) => { for (const n of names) { try { return $(n); } catch (e) {} } throw new Error('Node not found: ' + names.join(' / ')); };\n// Parse leads, drop duplicates + do-not-contact + low fit, cap 10 new per run\nconst raw = String($input.first().json.output ?? '');\nlet leads = [];\ntry { leads = JSON.parse(raw.replace(/^\\s*```(json)?/i, '').replace(/```\\s*$/, '').trim()).leads || []; } catch (e) {}\nconst norm = v => String(v || '').toLowerCase().trim();\nconst existing = pick('L: Get Leads').all().map(i => i.json);\nconst dnc = pick('L: Get DoNotContact').all().map(i => norm(i.json.entry)).filter(Boolean);\nconst seen = new Set(existing.map(l => norm(l.name) + '|' + norm(l.company)));\nconst blocked = l => dnc.some(e => e === norm(l.name) || e === norm(l.company) || (l.profile_url && e === norm(l.profile_url)));\nconst out = [];\nfor (const l of leads) {\n  const key = norm(l.name) + '|' + norm(l.company);\n  if (!l.name || !l.company || seen.has(key) || blocked(l) || Number(l.fit_score) < 60) continue;\n  if (String(l.profile_url || '').includes('linkedin.com')) l.profile_url = '';   // never store LinkedIn profile data\n  seen.add(key);\n  out.push({ json: { id: 'L' + Date.now() + out.length, name: l.name, role: l.role || '', company: l.company,\n                     profile_url: l.profile_url || l.source_url || '', fit_score: Math.round(Number(l.fit_score)),\n                     status: 'new', draft: '', next_action_at: '' } });\n  if (out.length >= 10) break;\n}\nreturn out;\n"
      },
      "name": "L: New Leads Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2064,
        368
