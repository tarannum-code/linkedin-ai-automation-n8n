        "jsCode": "const pick = (...names) => { for (const n of names) { try { return $(n); } catch (e) {} } throw new Error('Node not found: ' + names.join(' / ')); };\n// Person clicked \"I sent it\" / \"Skip\" -> new lead status + next follow-up date + next allowed outreach time\nconst l = pick('Q: Clean Draft').first().json;\nconst s = pick('Q: Get Settings').first().json;\nconst sent = String($json.query?.decision || '') === 'sent';\nconst now = DateTime.now();\nconst [gmin, gmax] = String(s.outreach_gap || '20-40').split(/[^0-9]+/).filter(Boolean).map(Number);\nconst gap = Math.floor(gmin + Math.random() * (gmax - gmin + 1));\nlet status = 'skipped', next = '';\nif (sent) {\n  status = { request: 'request_sent', message: 'messaged', followup: 'followed_up' }[l.stage];\n  if (l.stage === 'message') next = now.plus({ days: Number(s.followup_days) || 5 }).toISO();\n}\nreturn [{ json: { id: l.id, status, next_action_at: next,\n  log_action: sent ? 'outreach_sent' : 'outreach_skipped',\n  log_details: `${l.stage} | ${l.name} (${l.company})` + (sent ? ` | next_after=${now.plus({ minutes: gap }).toISO()}` : '') } }];\n"
