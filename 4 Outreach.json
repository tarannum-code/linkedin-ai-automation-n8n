      "parameters": {
        "jsCode": "// AI output -> one item per search query\nconst raw = String($input.first().json.output ?? '');\nlet q = [];\ntry { q = JSON.parse(raw.replace(/^\\s*```(json)?/i, '').replace(/```\\s*$/, '').trim()).queries || []; } catch (e) {}\nif (!q.length) throw new Error('AI did not return search queries: ' + raw.slice(0, 200));\nreturn q.slice(0, 4).map(query => ({ json: { query } }));\n"
      },
