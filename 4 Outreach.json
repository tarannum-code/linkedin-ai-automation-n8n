    {
      "parameters": {
        "jsCode": "const pick = (...names) => { for (const n of names) { try { return $(n); } catch (e) {} } throw new Error('Node not found: ' + names.join(' / ')); };\n// All search results -> one prompt for lead extraction + fit score\nconst s = pick('L: Get Settings').first().json;\nconst results = [];\nfor (const it of $input.all()) for (const r of (it.json.results || [])) results.push(`URL: ${r.url}\\nTITLE: ${r.title}\\nTEXT: ${String(r.content || '').slice(0, 600)}`);\nif (!results.length) return [];\nreturn [{ json: { prompt:\n`Target audience for our LMS: ${s.target_audience}\n\nFrom the PUBLIC web search results below, list real people who are explicitly named together with their role and organisation.\nRules:\n- Only people clearly stated in the results. Never invent names, roles, companies or links.\n- profile_url: a public profile/bio page of that person if one appears in the results (not linkedin.com), otherwise \"\".\n- source_url: the result URL where you found them.\n- fit_score 0-100: how well the person matches the target audience (role seniority, type and size of organisation, country).\n- fit_reason: max 15 words.\nMax 15 people. Answer ONLY with JSON: {\"leads\":[{\"name\":\"\",\"role\":\"\",\"company\":\"\",\"country\":\"\",\"profile_url\":\"\",\"source_url\":\"\",\"fit_score\":0,\"fit_reason\":\"\"}]}\n\nRESULTS:\n${results.join('\\n---\\n')}` } }];\n"
      },
      "name": "L: Combine Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
